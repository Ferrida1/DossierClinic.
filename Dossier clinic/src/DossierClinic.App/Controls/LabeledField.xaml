<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DossierClinic.Controls.LabeledField" x:Name="Root">
    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Label, Source={x:Reference Root}}" StyleClass="subtitle" />
        <Border StyleClass="Field">
            <Entry Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                   Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                   Keyboard="{Binding Keyboard, Source={x:Reference Root}}" />
        </Border>
    </VerticalStackLayout>
</ContentView>
