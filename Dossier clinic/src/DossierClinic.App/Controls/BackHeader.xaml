<?xml version="1.0" encoding="UTF-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      x:Class="DossierClinic.Controls.BackHeader" x:Name="Root"
      ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,12,16,8">
    <Border StyleClass="IconButton">
        <Label Text="←" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding BackCommand, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
    </Border>
    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
        <Label Text="{Binding Title, Source={x:Reference Root}}" StyleClass="title" LineBreakMode="TailTruncation" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}" StyleClass="subtitle"
               IsVisible="{Binding Subtitle, Source={x:Reference Root}, Converter={StaticResource StringToBool}}" />
    </VerticalStackLayout>
</Grid>
