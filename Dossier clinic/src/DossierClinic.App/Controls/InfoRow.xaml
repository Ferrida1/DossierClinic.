<?xml version="1.0" encoding="UTF-8" ?>
<VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="DossierClinic.Controls.InfoRow" x:Name="Root" Spacing="8">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Label Text="{Binding Caption, Source={x:Reference Root}}" StyleClass="muted" />
        <Label Grid.Column="1" Text="{Binding Value, Source={x:Reference Root}}" StyleClass="value" />
    </Grid>
    <BoxView StyleClass="Divider" />
</VerticalStackLayout>
