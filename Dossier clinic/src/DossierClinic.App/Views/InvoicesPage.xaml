<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:sm="clr-namespace:DossierClinic.Shared;assembly=DossierClinic.Shared" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.InvoicesPage" x:DataType="vm:InvoicesViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,0">
        <Label Text="Facturation" StyleClass="title" Padding="8,20,0,12" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border StyleClass="Card" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding CollectedText}" FontSize="18" FontAttributes="Bold" TextColor="#1E7A4C" />
                    <Label Text="Encaissé" StyleClass="subtitle" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" StyleClass="Card" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding OutstandingText}" FontSize="18" FontAttributes="Bold" TextColor="#C2412D" />
                    <Label Text="Reste à payer" StyleClass="subtitle" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,14,0,10">
            <HorizontalStackLayout Spacing="8">
                    <Button Text="Toutes" StyleClass="Pill" Command="{Binding SetFilterCommand}" CommandParameter="Toutes">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Toutes">
                                <Setter Property="BackgroundColor" Value="#0E6B66" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="#0E6B66" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="À encaisser" StyleClass="Pill" Command="{Binding SetFilterCommand}" CommandParameter="À encaisser">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="À encaisser">
                                <Setter Property="BackgroundColor" Value="#0E6B66" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="#0E6B66" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Soldées" StyleClass="Pill" Command="{Binding SetFilterCommand}" CommandParameter="Soldées">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Soldées">
                                <Setter Property="BackgroundColor" Value="#0E6B66" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="#0E6B66" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
            </HorizontalStackLayout>
        </ScrollView>
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Aucune facture." StyleClass="muted" HorizontalTextAlignment="Center" Margin="24,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:InvoiceRow">
                    <Border StyleClass="Card" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                            <Label Text="{Binding PatientName}" StyleClass="rowtitle" />
                            <Label Grid.Row="1" Text="{Binding Subtitle}" StyleClass="rowsub" />
                            <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="4" HorizontalOptions="End">
                                <Label Text="{Binding TotalText}" StyleClass="value" />
                                <ctl:StatusChip Status="{Binding Status}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRowTapped" /></Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
