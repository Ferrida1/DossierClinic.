<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:sm="clr-namespace:DossierClinic.Shared;assembly=DossierClinic.Shared" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.ConsultationsPage" x:DataType="vm:ConsultationsViewModel">
    <Grid RowDefinitions="Auto,*" Padding="16,0">
        <VerticalStackLayout Padding="8,20,0,12" Spacing="2">
            <Label Text="Consultations" StyleClass="title" />
            <Label Text="{Binding CountText}" StyleClass="subtitle" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Aucune consultation enregistrée." StyleClass="muted" HorizontalTextAlignment="Center" Margin="24,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:ConsultationRow">
                    <Border StyleClass="Card" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PatientName}" StyleClass="rowtitle" />
                                <Label Text="{Binding Subtitle}" StyleClass="rowsub" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="24" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRowTapped" /></Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
