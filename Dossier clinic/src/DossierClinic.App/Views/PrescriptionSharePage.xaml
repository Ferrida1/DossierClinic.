<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:sm="clr-namespace:DossierClinic.Shared;assembly=DossierClinic.Shared" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.PrescriptionSharePage" x:DataType="vm:PrescriptionShareViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <ctl:BackHeader Title="Ordonnance" Subtitle="{Binding DateText}" BackCommand="{Binding CloseCommand}" />
        <ScrollView Grid.Row="1">
            <Border StyleClass="Card" Margin="16,8,16,16">
                <Label Text="{Binding Text}" FontSize="15" LineHeight="1.3" />
            </Border>
        </ScrollView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,8,16,16">
            <Button Text="Fermer" StyleClass="Secondary" Command="{Binding CloseCommand}" />
            <Button Grid.Column="1" Text="Partager" Command="{Binding ShareCommand}" />
        </Grid>
    </Grid>
</ContentPage>
