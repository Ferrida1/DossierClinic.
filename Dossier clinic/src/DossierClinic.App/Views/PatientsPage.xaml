<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.PatientsPage" x:DataType="vm:PatientsViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto" Padding="8,20,0,0">
            <VerticalStackLayout Spacing="2">
                <Label Text="Patients" StyleClass="title" />
                <Label Text="{Binding CountText}" StyleClass="subtitle" />
            </VerticalStackLayout>
            <Border Grid.Column="1" StyleClass="IconButton">
                <Label Text="⚙" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSettingsCommand}" /></Border.GestureRecognizers>
            </Border>
        </Grid>
        <Border Grid.Row="1" StyleClass="Field" Margin="0,14,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="🔍" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Nom, téléphone ou numéro de dossier" ReturnType="Search" />
            </Grid>
        </Border>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Aucun patient. Touchez « Nouveau patient » pour créer le premier dossier." StyleClass="muted"
                       HorizontalTextAlignment="Center" Margin="24,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:PatientRow">
                    <Border StyleClass="Card" Padding="14" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="#0E6B66" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                    WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                <Label Text="{Binding Initials}" StyleClass="avatar" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Number}" FontSize="12" FontAttributes="Bold" TextColor="#0E6B66" />
                                <Label Text="{Binding Name}" StyleClass="rowtitle" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" StyleClass="rowsub" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" StyleClass="Chip" BackgroundColor="#FBE9E5" IsVisible="{Binding HasBalance}" VerticalOptions="Start">
                                <Label Text="{Binding BalanceText}" StyleClass="chip" TextColor="#C2412D" />
                            </Border>
                        </Grid>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRowTapped" /></Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3" Text="+ Nouveau patient" Command="{Binding NewPatientCommand}" Margin="0,8,0,12" HeightRequest="50" />
    </Grid>
</ContentPage>
