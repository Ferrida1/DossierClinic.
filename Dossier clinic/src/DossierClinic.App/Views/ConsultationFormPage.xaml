<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:sm="clr-namespace:DossierClinic.Shared;assembly=DossierClinic.Shared" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.ConsultationFormPage" x:DataType="vm:ConsultationFormViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="24,24,24,8" Spacing="2">
            <Label Text="Nouvelle consultation" StyleClass="title" />
            <Label Text="{Binding PatientLine}" StyleClass="subtitle" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,16" Spacing="14">
                <Border BackgroundColor="#FBE9E5" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14,10" IsVisible="{Binding HasAllergy}">
                    <Label Text="{Binding AllergyText}" StyleClass="alertDanger" />
                </Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Date" StyleClass="subtitle" />
                    <Border StyleClass="Field"><DatePicker Date="{Binding Date}" Format="dd/MM/yyyy" /></Border>
                </VerticalStackLayout>
                <ctl:LabeledField Label="Motif de la consultation" Text="{Binding Reason}" Placeholder="Ex. Fièvre et maux de tête" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <ctl:LabeledField Label="Temp. (°C)" Text="{Binding Temperature}" Keyboard="Numeric" />
                    <ctl:LabeledField Grid.Column="1" Label="Tension" Text="{Binding BloodPressure}" Placeholder="12/8" />
                    <ctl:LabeledField Grid.Column="2" Label="Poids (kg)" Text="{Binding Weight}" Keyboard="Numeric" />
                </Grid>
                <ctl:LabeledField Label="Diagnostic" Text="{Binding Diagnosis}" />
                <VerticalStackLayout Spacing="6">
                    <Label Text="Notes cliniques" StyleClass="subtitle" />
                    <Border StyleClass="Field" Padding="12,4"><Editor Text="{Binding Notes}" Placeholder="Test rapide positif…" AutoSize="TextChanges" MinimumHeightRequest="80" /></Border>
                </VerticalStackLayout>
                <Border StyleClass="Card" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ordonnance" StyleClass="subtitle" />
                            <Label Text="{Binding PrescriptionTitle}" StyleClass="rowtitle" FontSize="15" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PrescriptionCount}" TextColor="#0E6B66" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding EditPrescriptionCommand}" /></Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,8,16,16">
            <Button Text="Annuler" StyleClass="Secondary" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Enregistrer" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
