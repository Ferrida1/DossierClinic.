<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:DossierClinic.Controls" xmlns:vm="clr-namespace:DossierClinic.ViewModels" xmlns:svc="clr-namespace:DossierClinic.Services" xmlns:sm="clr-namespace:DossierClinic.Shared;assembly=DossierClinic.Shared" xmlns:conv="clr-namespace:DossierClinic.Converters" x:Class="DossierClinic.Views.PaymentPage" x:DataType="vm:PaymentViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <ctl:BackHeader Title="Encaisser un paiement" Subtitle="{Binding Subtitle}" BackCommand="{Binding CancelCommand}" />
        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="12">
            <ctl:LabeledField Label="Montant reçu (FCFA)" Text="{Binding Amount}" Keyboard="Numeric" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Tout" StyleClass="Pill" Command="{Binding AllCommand}" />
                <Button Text="Moitié" StyleClass="Pill" Command="{Binding HalfCommand}" />
                <Button Text="{Binding QuickAmountLabel}" StyleClass="Pill" Command="{Binding QuickCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,8,16,16">
            <Button Text="Annuler" StyleClass="Secondary" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Valider" Command="{Binding ValidateCommand}" />
        </Grid>
    </Grid>
</ContentPage>
