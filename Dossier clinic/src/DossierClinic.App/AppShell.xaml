<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:DossierClinic.Views"
       x:Class="DossierClinic.AppShell"
       FlyoutBehavior="Disabled" Shell.NavBarIsVisible="False">
    <TabBar>
        <ShellContent Title="Patients" Icon="tab_patients.png" ContentTemplate="{DataTemplate views:PatientsPage}" Route="patients" />
        <ShellContent Title="Consultations" Icon="tab_consultations.png" ContentTemplate="{DataTemplate views:ConsultationsPage}" Route="consultations" />
        <ShellContent Title="Factures" Icon="tab_invoices.png" ContentTemplate="{DataTemplate views:InvoicesPage}" Route="invoices" />
        <ShellContent Title="Recherche" Icon="tab_search.png" ContentTemplate="{DataTemplate views:SearchPage}" Route="search" />
    </TabBar>
</Shell>
